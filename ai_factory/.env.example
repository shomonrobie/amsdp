# AMSDP AI Factory configuration examples.
# Copy this file to `ai_factory/.env` and adjust locally.
# `.env` is git-ignored; real secrets must never be committed.

# Factory environment: development | test | production
AMSDP_FACTORY_ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
AMSDP_FACTORY_LOG_LEVEL=INFO

# Optional explicit repository-root override. If unset, the repository root
# is auto-discovered by walking upwards to the first directory containing a
# `.git` marker.
# AMSDP_FACTORY_REPO_ROOT=/absolute/path/to/amsdp

# Default bound on automated retries for a failing workflow stage.
AMSDP_FACTORY_DEFAULT_MAX_RETRIES=2

# Model/provider configuration for LIVE CrewAI runs only.
# Tests and stub mode do not require a provider.
# Leave these unset: context loading, task records, and validation never call
# a model provider.
#
# Supported providers (``model_provider``):
# - ``openrouter``: uses CrewAI ``LLM`` class with ``base_url`` set to
#   https://openrouter.ai/api/v1 and reads the API key from the
#   ``OPENROUTER_API_KEY`` environment variable.
# - any other value (or unset): passes ``model_id`` as a model-name string
#   directly to CrewAI's built-in provider resolver.
#
# Example model IDs:
# - OpenRouter: ``deepseek/deepseek-v4-flash``, ``openai/gpt-4``
# - Direct OpenAI: ``gpt-4``, ``gpt-3.5-turbo``
# - Direct Anthropic: ``claude-3-5-sonnet``
# - Local via Ollama: ``ollama/llama3``
#
AMSDP_FACTORY_MODEL_PROVIDER=
AMSDP_FACTORY_MODEL_ID=

# Provider credentials are read ONLY from the process environment at
# live-run time (e.g. OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY
# style variables required by the configured provider).
# Never place real credentials in this file.
# OPENROUTER_API_KEY=sk-or-v1-placeholder

# Live execution gate:
# Set to 1 ONLY after the model provider is configured and the API key is
# set in the process environment. Never leave at 1 when not actively running.
# AMSDP_FACTORY_LIVE_EXECUTION_ALLOWED=1