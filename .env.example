# AMSDP local environment template — copy to .env and fill in the values.
#
#   cp .env.example .env    # then edit .env
#
# .env is gitignored and must never be committed.  It is read by:
#   * docker compose (variable interpolation in docker-compose.yml /
#     docker-compose.demo.yml),
#   * the scripts in _tools/ (init_demo_env.sh, pg_backup.sh, pg_restore_test.sh),
#   * backend/seed/seed_demo.py (demo staff passwords).
# Keep entries shell-safe: `_tools/*.sh` source this file, so quote any value
# that contains spaces or shell metacharacters, e.g.
#   POSTGRES_PASSWORD='<choose-a-strong-password>'
# Keep demo passwords free of double quotes and backslashes: init_demo_env.sh
# interpolates the receptionist password into a JSON login payload.

# --- PostgreSQL (development stack: `db` service, host port 5433) -----------
# Required — compose fails with a clear message when it is missing.
# It is used both for the container and for the composed AMSDP_DATABASE_URL.
# The password only takes effect when the postgres volume is first created; if
# the volume already exists, keep the value it was created with.
POSTGRES_PASSWORD=replace-me

# Optional — override the whole DSN instead of the composed default
# (default: postgresql+psycopg2://amsdp:${POSTGRES_PASSWORD}@db:5432/amsdp).
# AMSDP_DATABASE_URL=postgresql+psycopg2://amsdp:REPLACE_ME@db:5432/amsdp

# --- Demo stack (docker-compose.demo.yml, project name amsdp_demo) ----------
# Optional — default composes the password into the amsdp_demo database.
# AMSDP_DATABASE_URL_DEMO=postgresql+psycopg2://amsdp:REPLACE_ME@db:5432/amsdp_demo

# --- Demo staff passwords (backend/seed/seed_demo.py) ----------------------
# Required by the seed script, one entry per account.  A single shared
# AMSDP_DEMO_PASSWORD is used for any account without its own value.
AMSDP_DEMO_PASSWORD_ADMIN=replace-me
AMSDP_DEMO_PASSWORD_ORG_ADMIN=replace-me
AMSDP_DEMO_PASSWORD_BR_ADMIN=replace-me
AMSDP_DEMO_PASSWORD_RECEPTIONIST=replace-me
AMSDP_DEMO_PASSWORD_DOCTOR=replace-me
AMSDP_DEMO_PASSWORD_ASSISTANT=replace-me
# AMSDP_DEMO_PASSWORD=replace-me

# --- Backup / restore scripts (_tools/pg_backup.sh, pg_restore_test.sh) ----
# Optional — they default to POSTGRES_PASSWORD; set this only to use a
# different role password for dump/restore.
# AMSDP_DB_PASSWORD=replace-me

# --- JWT signing key (optional) -------------------------------------------
# compose falls back to a non-secret development key.  Set a real value here
# (and AMSDP_ENV=production) before exposing the stack to a network.
# AMSDP_JWT_SECRET=replace-me
